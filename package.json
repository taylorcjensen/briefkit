{
  "name": "briefkit",
  "version": "0.1.11",
  "description": "Static Markdown/MDX report-site toolkit for fast agent-authored briefs.",
  "keywords": [
    "agent",
    "astro",
    "brief",
    "markdown",
    "mdx",
    "report",
    "static-site"
  ],
  "homepage": "https://taylorcjensen.github.io/briefkit/",
  "bugs": {
    "url": "https://github.com/taylorcjensen/briefkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorcjensen/briefkit.git"
  },
  "type": "module",
  "bin": {
    "briefkit": "bin/briefkit.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/report.css"
  },
  "files": [
    "bin",
    "src",
    "docs/recharts.md",
    "skills",
    "publish-server",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"test/**/*.test.ts\"",
    "test:packaged-install": "node --import tsx/esm --test test/packagedInstall.smoke.ts",
    "astro:check": "astro check",
    "check": "npm run typecheck && npm run astro:check && npm test",
    "briefkit": "node --import tsx/esm ./bin/briefkit.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "7.0.0",
    "astro": "7.2.8",
    "csv-parse": "7.0.3",
    "esbuild": "^0.28.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.18",
    "postcss-value-parser": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tsx": "^4.20.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^25.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
